<%- include('layouts/partials/header') %>
<main id="main" class="container page-main"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Products</a><span>/</span><span><%= product.name %></span></nav><article class="detail-card"><div class="detail-visual"><img src="<%= product.imageUrl || fallback(product.category.slug) %>" data-fallback="<%= fallback(product.category.slug) %>" alt="<%= product.name %>" loading="lazy" width="560" height="420"></div><div class="detail-content"><span class="chip"><%= product.category.name %></span><p class="sku"><%= product.sku %></p><h1><%= product.name %></h1><p class="detail-price"><%= money(product.price) %></p><div class="description"><h2>About this product</h2><p><%= product.description || 'An everyday essential, ready for your next setup.' %></p></div><dl><div><dt>Category</dt><dd><%= product.category.name %></dd></div><div><dt>Added</dt><dd><time datetime="<%= product.createdAt %>"><%= date(product.createdAt) %> (UTC+7)</time></dd></div><div><dt>Currency</dt><dd>Vietnamese đồng · VND</dd></div></dl><a class="button secondary" href="/">← Back to products</a></div></article></main>
<%- include('layouts/partials/footer') %>
