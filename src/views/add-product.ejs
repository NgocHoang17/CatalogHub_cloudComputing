<%- include('layouts/partials/header') %>
<main id="main" class="container page-main"><a href="/" class="back-link">← Back to products</a><p class="eyebrow">GROW THE COLLECTION</p><h1 class="page-title">Something great to add.</h1><p class="lead">Give your product a place in the CatalogHub collection.</p>
<div class="form-layout"><section class="form-card"><h2>Product information</h2><p class="subtle">Fields marked * are required.</p>
<% if (!writeEnabled) { %><div class="notice" role="status">Demo write access is disabled on this deployment</div><% } %>
<% if (loadError) { %><div class="notice error" role="alert"><%= loadError %> <a href="/products/new">Retry</a></div><% } %>
<form id="product-form" novalidate><fieldset <%= !writeEnabled || loadError ? 'disabled' : '' %>>
<div class="field"><label for="name">Product Name *</label><input id="name" name="name" required minlength="3" maxlength="160" placeholder="e.g. Mechanical Keyboard K100" aria-describedby="name-error"><span class="field-error" id="name-error"></span></div>
<div class="form-row"><div class="field"><label for="sku">SKU *</label><input id="sku" name="sku" required minlength="3" maxlength="32" pattern="[A-Za-z0-9-]{3,32}" placeholder="KB-100" aria-describedby="sku-error"><span class="field-error" id="sku-error"></span></div><div class="field"><label for="categoryId">Category *</label><select id="categoryId" name="categoryId" required aria-describedby="categoryId-error"><option value="">Select category</option><% categories.forEach(category => { %><option value="<%= category.id %>"><%= category.name %></option><% }) %></select><span class="field-error" id="categoryId-error"></span></div></div>
<div class="field"><label for="price">Price (VND) *</label><input id="price" name="price" required inputmode="decimal" placeholder="1290000.00" aria-describedby="price-error"><span class="field-error" id="price-error"></span></div>
<div class="field"><label for="description">Description <span>Optional</span></label><textarea id="description" name="description" rows="4" maxlength="2000" placeholder="What makes this product a great addition?" aria-describedby="description-error"></textarea><span class="field-error" id="description-error"></span></div>
<div class="field"><label for="imageUrl">Image URL <span>Optional</span></label><input id="imageUrl" name="imageUrl" type="url" maxlength="2048" placeholder="https://example.com/product.jpg" aria-describedby="imageUrl-error"><span class="field-error" id="imageUrl-error"></span><small>A local illustration is used when no image is provided.</small></div>
<div class="form-actions"><a class="button secondary" href="/">Cancel</a><button class="button" id="submit-product" type="submit">Add product <span aria-hidden="true">＋</span></button></div></fieldset></form>
<div id="form-status" aria-live="polite" tabindex="-1"></div><noscript><p class="notice">Enable JavaScript to submit this form to the catalog API.</p></noscript>
</section><aside class="form-aside"><div class="aside-art"><img src="/assets/products/keyboards.svg" alt="Keyboard illustration" width="320" height="220"></div><p class="eyebrow">A LITTLE ATTENTION TO DETAIL</p><h2>Great products deserve<br>great introductions.</h2><ul class="tips"><li><strong>Keep it recognizable</strong><p>Use a clear product name and a unique SKU.</p></li><li><strong>Find the right home</strong><p>Choose the category that best fits your product.</p></li><li><strong>Make the details count</strong><p>A short description helps visitors make a choice.</p></li></ul><div class="notice"><strong>Academic demo</strong><p>This form and API have no authentication. Public write access can allow spam. Enable writes only for a controlled demo.</p></div></aside></div></main>
<script src="/js/product-form.js" defer></script>
<%- include('layouts/partials/footer') %>
